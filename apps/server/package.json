{
  "name": "@roe/server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative multiplayer server (Colyseus).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@roe/source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.10",
    "@colyseus/schema": "^5.0.50",
    "@colyseus/ws-transport": "^0.18.0",
    "@roe/game-data": "workspace:*",
    "@roe/shared": "workspace:*",
    "@roe/sim": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15"
  }
}
